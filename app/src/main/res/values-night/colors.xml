<?xml version="1.0" encoding="utf-8"?>
<!--
  Dark-mode variants for the colours that were previously light-only. Without
  these, the category tiles, topic chips and security badges rendered as bright
  pastel blocks on a dark background, and the light-green dark-mode accent had
  almost no contrast against them.
-->
<resources>
    <!-- Chip background for dark mode -->
    <color name="chip_background">#1B3D2F</color>



    <!-- Security badge colors (VirusTotal). The light-mode values are dark
         greens/reds that all but disappear against a dark surface. -->
    <color name="badge_safe_text">#81C784</color>
    <color name="badge_flagged_text">#EF9A9A</color>
    <color name="badge_unknown_text">#BDBDBD</color>

    <!-- Category Icon Backgrounds (deep tints) -->
    <color name="cat_bg_blue">#14293D</color>
    <color name="cat_bg_green">#16301B</color>
    <color name="cat_bg_red">#3A1B1F</color>
    <color name="cat_bg_orange">#3A2A14</color>
    <color name="cat_bg_purple">#2E1B33</color>
    <color name="cat_bg_teal">#12302E</color>
    <color name="cat_bg_indigo">#1C2038</color>
    <color name="cat_bg_pink">#3A1B28</color>
    <color name="cat_bg_yellow">#33301A</color>
    <color name="cat_bg_brown">#2C2523</color>
    <color name="cat_bg_cyan">#113035</color>
    <color name="cat_bg_lime">#2A3016</color>
</resources>
